import os
import csv
dado="dados.csv"


###INICIA O BANCO DE DADOS
def dados_iniciar():
    if not os.path.exists(dado):
        with open(dado,'w',newline='',encoding='utf-8')as dd:
            escrever=csv.writer(dd)
            escrever.writerow(['nome','produto','preco'])


###LER ESSES DADOS
def criar_dados():
    print("\n -----LISTA DE DADOS REGISTRADOS-----")
    nome=input("digite um nme do arquivo")
    texto=input("digite uma descricao ou um texto")

    with open(dado,'r',encoding='utf8') as dd:
        ler=csv.reader(dd)
        ler.writerow([nome,texto])
    print('dados salvo com sucesso')


